# Written fresh on every run (the "last checked" time). It is published with
# the site but never committed, so unchanged data doesn't create a commit.
site/data/status.json

# Leftovers from an interrupted write in fetch_kev.py
site/data/.*.tmp

# Python / OS clutter
__pycache__/
*.pyc
.DS_Store

# Feeds are built on every deploy from the data (scripts/build_feeds.py), never committed.
site/feeds/*.xml
site/feeds/vendors/
site/feeds/vendors.json
